MONGODB_URI=mongodb://127.0.0.1:27017/ai-business
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:3000
PORT=8080

# Public app URL (used in password reset links)
APP_URL=http://localhost:3000

# AI generation (OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Production: real OTP on user’s email (required for launch) ---
# Gmail (recommended):
# 1) Google Account → Security → turn on 2-Step Verification
# 2) App passwords → create "Mail" / "Other" → copy 16-character password
# 3) Fill below (normal Gmail password does NOT work for SMTP)
#
SMTP_SERVICE=gmail
SMTP_USER=yourname@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
EMAIL_FROM=yourname@gmail.com
#
# Optional: other SMTP (SendGrid, etc.) — leave SMTP_SERVICE empty and set host:
# SMTP_SERVICE=
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-key
# EMAIL_FROM=verified-sender@yourdomain.com

APP_NAME=AI Business

# Local dev: comment out SMTP_* above or leave SMTP_USER empty → test mail (Ethereal) + terminal OTP
